{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fingerprint-demo",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "demo.server"
      ],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "fingerprint-demo-running",
      "url": "http://localhost:8000"
    },
    {
      "name": "fingerprint-demo-8001",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=8001",
        ".venv/bin/python",
        "-m",
        "demo.server"
      ],
      "port": 8001,
      "autoPort": false
    },
    {
      "name": "results-site",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8010",
        "--directory",
        "site"
      ],
      "port": 8010,
      "autoPort": false
    }
  ]
}